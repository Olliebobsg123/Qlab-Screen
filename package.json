{
  "name": "qlab-screen",
  "version": "0.2.0",
  "description": "A QLab monitor and optional remote control for relay screens, backstage displays, and TV dashboards.",
  "author": "Thomas Dye",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "check": "node scripts/check.mjs",
    "mac:install": "bash scripts/mac-service.sh install",
    "mac:restart": "bash scripts/mac-service.sh restart",
    "mac:status": "bash scripts/mac-service.sh status",
    "mac:logs": "bash scripts/mac-service.sh logs",
    "mac:uninstall": "bash scripts/mac-service.sh uninstall",
    "dist:win": "electron-builder --win --publish never"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.tds.qlabconnect",
    "productName": "QLab Connect",
    "artifactName": "QLab-Connect-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "server.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "QLab Connect uses the microphone for comms (talkback between departments).",
        "NSLocalNetworkUsageDescription": "QLab Connect finds the show computer and sends comms audio on your local network."
      },
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "QLab-Connect-Setup-${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "acme-client": "^5.4.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "node-osc": "^11.4.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.14"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.8.1"
  }
}
